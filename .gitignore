# Root build logs. Ignored patterns also keep these out of agent search
# (ripgrep honors .gitignore even for files that are still tracked).
/build_*.txt

# Agent skills live only in .claude/skills (installed by script/update-skills.sh).
# The `skills` CLI installs into every agent it detects on the machine, so keep
# the copies it writes for other agents out of the repo.
