# Project verification commands. The project must be trusted to load these rules.
prefix_rule(pattern=["git", "status"], decision="allow")
prefix_rule(pattern=["git", "diff"], decision="allow")
prefix_rule(pattern=["git", "log"], decision="allow")
prefix_rule(pattern=["git", "show"], decision="allow")
prefix_rule(pattern=["git", "grep"], decision="allow")
prefix_rule(pattern=["git", "branch", "--list"], decision="allow")
prefix_rule(pattern=["git", "branch", "--show-current"], decision="allow")
prefix_rule(pattern=["git", "branch", "--all"], decision="allow")
prefix_rule(pattern=["python3", "ci_scripts/validate_local_persistence.py"], decision="allow")
prefix_rule(pattern=["python3", "-m", "unittest", "ci_scripts/test_validate_local_persistence.py"], decision="allow")
prefix_rule(pattern=["bash", "ci_scripts/ci_pre_xcodebuild.sh"], decision="allow")
prefix_rule(pattern=["swiftlint"], decision="allow")
prefix_rule(pattern=["xcrun", "simctl", "list"], decision="allow")
prefix_rule(pattern=["xcodebuild", "-list"], decision="allow")
prefix_rule(pattern=["xcodebuild", "-showBuildSettings"], decision="allow")
prefix_rule(pattern=["xcodebuild", "test", "-project", "Pawtrackr.xcodeproj", "-scheme", "Pawtrackr"], decision="allow")
